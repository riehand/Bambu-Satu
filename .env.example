# Public configuration: copy from your Supabase project, never put real values here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Do not put a Storage service-role key in the interactive website environment.
# Hosted PDF requires a separately approved worker and private bucket; see
# docs/DEVELOPMENT-ENVIRONMENT-CONSOLIDATION.md. Local worker config is separate.

# Server-only canonical website origin.
SITE_URL=http://localhost:3000

# Prisma 5.22: an approved least-privilege role only, never postgres/owner.
# Hosted clinical DAL remains BLOCKED until its identity adapter/gateways exist.
# Changing DATABASE_URL alone does not install a hosted restricted runtime.
# Copy the exact Session pooler string for IPv4-only hosts.
# URL-encode the password. Keep credentials in ignored .env.local/.env only.
DATABASE_URL=postgresql://website_runtime.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# Migration connection, only for separately approved operations; never a runtime fallback.
DIRECT_URL=postgresql://YOUR_MIGRATION_USER.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
