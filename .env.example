# Public configuration: copy from your Supabase project, never put real values here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Do not put a Storage service-role key in the interactive website environment.
# Hosted PDF requires a separately approved worker and private bucket; see
# deployment/hosted/APPROVAL.md. Local testing remains optional.

# Server-only canonical website origin.
SITE_URL=http://localhost:3000

# Enable after the one-time hosted DB + services setup has been approved/completed.
WELLBEING_RUNTIME=hosted
WELLBEING_HOSTED_PROJECT_REF=YOUR_PROJECT_REF
# Restricted runtime, never postgres/owner. URL-encode the password.
DATABASE_URL=postgresql://website_runtime.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require&sslaccept=strict&connection_limit=1
# Hosted authorities: configured once for the team; no laptop processes required.
WELLBEING_SIGNER_URL=https://YOUR_APPROVED_SIGNER_HOST
# Alternative after deploying the authenticated wellbeing-signer Edge Function:
# WELLBEING_SIGNER_MODE=supabase-edge
# In this mode the project-pinned endpoint is derived automatically; no signer
# transport token or identity signing key belongs in developer environment files.
WELLBEING_SIGNER_TOKEN=REPLACE_PRIVATELY_WITH_64_HEX_CHARACTERS
WELLBEING_PDF_WORKER_URL=https://YOUR_APPROVED_WORKER_HOST
WELLBEING_PDF_WORKER_TOKEN=REPLACE_PRIVATELY_WITH_DIFFERENT_64_HEX_CHARACTERS
# No DIRECT_URL/operator password, Storage secret, signing key, or local fixture here.
# Migration/operator configuration belongs in a separate private process.
