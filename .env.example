# Public configuration: copy from your Supabase project, never put real values here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Server-only canonical website origin.
SITE_URL=http://localhost:3000

# Prisma 5.22 runtime. Copy the exact Session pooler string for IPv4-only hosts.
# URL-encode the password. Keep credentials in ignored .env.local/.env only.
DATABASE_URL=postgresql://YOUR_DB_USER.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# Migration connection: Session pooler (5432) or direct connection where IPv6 works.
DIRECT_URL=postgresql://YOUR_DB_USER.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# No Supabase secret/service-role API key is required by the website.
