# Configuration template only. Never put actual secrets in this file.
# Build-time public configuration: use the approved preview project's publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://APPROVED_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_APPROVED_PUBLISHABLE_KEY
# Exact HTTPS origin, also approved in Auth redirect settings.
SITE_URL=https://APPROVED_PREVIEW_HOST
# Restricted role only. No postgres / migration owner / BYPASSRLS credentials.
DATABASE_URL=postgresql://website_runtime:REPLACE_PRIVATELY@APPROVED_DB_HOST:5432/APPROVED_DB?sslmode=require&sslaccept=strict&connection_limit=1
# Do not set WELLBEING_LOCAL_RUNTIME_FILE, local HMAC fixtures or rehearsal markers.
# Staging adapter requires the approved SQL package and separate signer/worker.
# Worker database, Storage and signing secrets belong to a separate worker service.

# Set only on the approved Preview branch, never Production.
WELLBEING_RUNTIME=staging
WELLBEING_STAGING_PROJECT_REF=REPLACE_WITH_APPROVED_PROJECT_REF
WELLBEING_SIGNER_URL=https://APPROVED_SIGNER_HOST
WELLBEING_SIGNER_TOKEN=REPLACE_PRIVATELY_WITH_64_HEX_CHARACTERS
WELLBEING_PDF_WORKER_URL=https://APPROVED_WORKER_HOST
WELLBEING_PDF_WORKER_TOKEN=REPLACE_PRIVATELY_WITH_DIFFERENT_64_HEX_CHARACTERS
# Do not put identity/PDF signing keys or SUPABASE_SECRET_KEY in the website.
# See STAGING-FIRST-TIME.md for per-service secrets and first-time setup.
